# POps demo settings. setup-host.sh copies this file to .env.demo and fills the empty secrets with random values
# (mode 600). .env.demo is never committed. Avoid "$" in values (Compose reads this file).

# Image tag on ghcr.io/pashacore/pops-{backend,dashboard}; built from this checkout when it is not published
POPS_IMAGE_TAG=local
# Panel port on 127.0.0.1 (the host's Apache proxies the public name to it)
POPS_DEMO_PORT=8180
TZ=Europe/Istanbul

# Database (internal network only)
DB_NAME=pops_demo
DB_USER=pops_demo
DB_PASS=

# Backend
JWT_SECRET=
# Superadmin for the owner (created on the first start); setup-host.sh prints the password once
PANEL_ADMIN_USER=yonetici
PANEL_ADMIN_PASS=
LOG_LEVEL=WARNING

# Public read-only account: name for the backend, "user:password" for the sign-in page and seed.py
POPS_DEMO_USERS=demo
POPS_DEMO_LOGIN=demo:demo

# Fake fleet: enrollment token (seed.py stores only its hash), school calendar, share left on at night
DEMO_ENROLL_TOKEN=
DEMO_FLEET_SCHEDULE=school
DEMO_FLEET_NIGHT_ON=0.4
DEMO_FLEET_HB=10
