<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MSI custom action'ları (DTF). Windows Installer bunları .NET Framework içinde çalıştırır;
    derleme sonunda MakeSfxCA, bağımlılıklarıyla birlikte PopsInstallerActions.CA.dll üretir.
    Sürüm kök VERSION dosyasından değil, paketle birlikte gelir; bu DLL ajan sürümünü taşımaz.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Platform, MakeSfxCA'nın x64 SfxCA.dll'i seçmesi için; PlatformTarget yönetilen kod için.
         İkisi uyuşmazsa custom action kurulumda BadImageFormatException ile düşer. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <!-- Nullable açık; temiz olmayan eski dosyaların ilk satırı "#nullable disable" (taban, yalnızca küçülür; kural
         Agent/Directory.Build.props'ta). Bu proje Agent/ uyarı kapısının dışında olduğundan nullable uyarıları burada
         ayrıca hata sayılır: yeni dosya nullable açısından temiz olmalı. -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Karantina kilit politikalarını geri alma mantığı ajanla ortak (kaldırmada kalıntı bırakılmaz); veri ve log
       klasörlerinin seçimi ve izinleri (appsettings.json DataDirectory / LogDirectory) ajanla aynı kuralla -->
  <ItemGroup>
    <Compile Include="..\..\..\Agent\POps.Shared\KioskPolicies.cs" Link="KioskPolicies.cs" />
    <Compile Include="..\..\..\Agent\POps.Shared\FolderSettings.cs" Link="FolderSettings.cs" />
  </ItemGroup>

</Project>
