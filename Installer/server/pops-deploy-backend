#!/usr/bin/env bash
# POps backend'ini repodaki commit'lenmiş koddan canlıya alır:
# Backend/*.py + Backend/pops/ paketi + migrations/ -> /opt/PashaCore_API, gerekirse pip
# install, servis restart, sağlık kontrolü; kontrol başarısızsa TÜM kod seti yedekten geri
# yüklenir (server.py artık tek dosya değil; uçlar pops/routers/ altında).
#
# NOT: Bu, sürüm takibi için tutulan REFERANS kopyadır. Canlıda çalışan authoritative
# kopya /usr/local/sbin/pops-deploy-backend'dedir (root'a ait, betiğin kendini çalışma
# sırasında ezmemesi için repoda değil host'ta durur). Bu dosyayı değiştirdiğinizde
# host'takini de elle güncelleyin.
set -euo pipefail

REPO=/home/pasha/domains/dev.pashacore.com.tr/public_html
APP=/opt/PashaCore_API
SVC=pashacore
OWNER=pashacore_admin
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUPS="$APP/.deploy-backups"
KEEP_BACKUPS=10

[ "$(id -u)" -eq 0 ] || { echo "root olarak çalıştır"; exit 1; }
cd "$REPO"

# Yalnız commit'lenmiş kod canlıya gider: değişiklik ya da izlenmeyen dosya varsa dur.
if ! git diff --quiet HEAD -- Backend || [ -n "$(git ls-files --others --exclude-standard Backend)" ]; then
    echo "Backend/ altında commit'lenmemiş ya da izlenmeyen dosya var, önce commit'le."
    exit 1
fi
REV=$(git rev-parse --short HEAD)

# Dağıtılan kod seti = git'te İZLENEN Backend altındaki .py'ler (server.py, migrate.py, pops/ paketi...;
# testler hariç). git pathspec'te '*' alt dizinleri de kapsar.
mapfile -t CODE < <(git ls-files 'Backend/*.py' | grep -v '^Backend/tests/' | sort)
[ "${#CODE[@]}" -gt 0 ] || { echo "Dağıtılacak kod bulunamadı"; exit 1; }

# Kaynak manifesti: "<canlıdaki göreli yol> <sha256>" (VERSION ve anahtar repo kökünden gelir)
manifest_src() {
    for f in "${CODE[@]}"; do printf '%s %s\n' "${f#Backend/}" "$(sha256sum < "$f" | cut -d' ' -f1)"; done
    for f in Backend/migrations/*.sql; do printf 'migrations/%s %s\n' "$(basename "$f")" "$(sha256sum < "$f" | cut -d' ' -f1)"; done
    printf 'requirements.txt %s\n' "$(sha256sum < Backend/requirements.txt | cut -d' ' -f1)"
    printf 'VERSION %s\n' "$(sha256sum < VERSION | cut -d' ' -f1)"
    printf 'keys/pops_release_ed25519.pub.pem %s\n' "$(sha256sum < keys/pops_release_ed25519.pub.pem | cut -d' ' -f1)"
}
same=1
while read -r rel sum; do
    [ -e "$APP/$rel" ] && [ "$(sha256sum < "$APP/$rel" | cut -d' ' -f1)" = "$sum" ] || { same=0; break; }
done < <(manifest_src)
# Kaynaktan silinmiş ama canlıda kalmış bir pops modülü de fark sayılır
if [ "$same" = 1 ] && [ -d "$APP/pops" ]; then
    extra=$(cd "$APP" && find pops -name '*.py' | sort | comm -23 - <(printf '%s\n' "${CODE[@]}" | sed 's#^Backend/##' | grep '^pops/' | sort))
    [ -z "$extra" ] || same=0
fi
if [ "$same" = 1 ]; then
    echo "Canlı backend zaten $REV ile aynı."
    exit 0
fi

# Geri dönüş için mevcut canlı kod setinin TAMAMINI yedekle
install -d -o root -g root -m 700 "$BACKUPS"
BACKUP="$BACKUPS/code-$STAMP-$$.tgz"          # PID: aynı saniyedeki iki deploy birbirinin yedeğini ezmesin
PRE_LIST="${BACKUP%.tgz}.list"                  # kurulum ÖNCESİ dosyalar: geri dönüşte yeni eklenenler silinir
( cd "$APP" && { ls ./*.py 2>/dev/null; ls ./migrations/*.sql 2>/dev/null; } ) > "$PRE_LIST" || true
( cd "$APP" && tar czf "$BACKUP" --exclude='__pycache__' $(ls ./*.py 2>/dev/null) \
    $( [ -d pops ] && echo pops ) $( [ -d migrations ] && echo migrations ) $( [ -d keys ] && echo keys ) \
    $( [ -e requirements.txt ] && echo requirements.txt ) $( [ -e VERSION ] && echo VERSION ) )
ls -1t "$BACKUPS"/code-*.tgz 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while read -r old; do
    rm -f "$old" "${old%.tgz}.list"
done

# Servis kullanıcısı repo klasörünü okuyamaz; dosyalar $APP'e kopyalanır.
if ! cmp -s Backend/requirements.txt "$APP/requirements.txt"; then
    install -o "$OWNER" -g "$OWNER" -m 644 Backend/requirements.txt "$APP/requirements.txt"
    sudo -H -u "$OWNER" "$APP/venv/bin/pip" install -q --disable-pip-version-check -r "$APP/requirements.txt"
fi

# Migration SQL'leri (yalnız eklenir; server.py açılışta bekleyenleri idempotent uygular). Not: ileride
# yıkıcı/ağır bir migration gelirse restart'tan ÖNCE pg_dump + "python migrate.py" adımı eklenmeli.
install -d -o "$OWNER" -g "$OWNER" -m 755 "$APP/migrations"
for f in Backend/migrations/*.sql; do
    install -o "$OWNER" -g "$OWNER" -m 644 "$f" "$APP/migrations/$(basename "$f")"
done

# pops/ paketi temiz kurulur (kaynaktan silinen modül canlıda kalmasın), sonra tüm kod dosyaları
rm -rf "$APP/pops"
for f in "${CODE[@]}"; do
    rel="${f#Backend/}"
    install -d -o "$OWNER" -g "$OWNER" -m 755 "$APP/$(dirname "$rel")"
    install -o "$OWNER" -g "$OWNER" -m 644 "$f" "$APP/$rel"
done

# Kök VERSION + release doğrulama açık anahtarı
install -o "$OWNER" -g "$OWNER" -m 644 VERSION "$APP/VERSION"
install -d -o "$OWNER" -g "$OWNER" -m 755 "$APP/keys"
install -o "$OWNER" -g "$OWNER" -m 644 keys/pops_release_ed25519.pub.pem "$APP/keys/pops_release_ed25519.pub.pem"

systemctl restart "$SVC"
sleep 4

ok=1
systemctl is-active --quiet "$SVC" || ok=0
[ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/api/health)" = 200 ] || ok=0
[ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/api/agent_policies)" = 200 ] || ok=0
[ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8000/api/devices)" = 401 ] || ok=0

if [ "$ok" = 1 ]; then
    echo "Backend $REV canlıda. Yedek: $BACKUP"
else
    set +e   # geri yüklemenin hiçbir adımı yarıda kesilmesin
    echo "Sağlık kontrolü başarısız, önceki kod seti geri yükleniyor ($BACKUP)."
    journalctl -u "$SVC" -n 20 --no-pager
    # Bu deploy'un YENİ eklediği üst-seviye .py ve migration dosyalarını sil (öncesinde yoklardı)
    ( cd "$APP" && { ls ./*.py 2>/dev/null; ls ./migrations/*.sql 2>/dev/null; } ) \
        | grep -vxF -f "$PRE_LIST" | ( cd "$APP" && xargs -r rm -f )
    rm -rf "$APP/pops"
    tar xzf "$BACKUP" -C "$APP"
    chown -R "$OWNER:$OWNER" "$APP"/*.py "$APP/migrations" 2>/dev/null || true
    [ -d "$APP/pops" ] && chown -R "$OWNER:$OWNER" "$APP/pops"
    systemctl restart "$SVC"
    exit 1
fi
