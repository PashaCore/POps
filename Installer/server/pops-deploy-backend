#!/usr/bin/env bash
# POps backend'ini repodaki commit'lenmiş koddan canlıya alır:
# Backend/*.py + Backend/pops/ paketi + migrations/ -> $APP, gerekirse pip install, servis restart,
# sağlık kontrolü. İlk değişiklikten sonraki HER hata (pip, dosya kopyalama, restart, sağlık kontrolü)
# tek bir geri dönüş yolundan geçer: TÜM kod seti ve requirements değiştiyse venv de yedekten birebir
# geri yüklenir (server.py artık tek dosya değil; uçlar pops/routers/ altında).
#
# Python sürümü: requirements.txt'teki "# requires-python: >=X.Y" satırı venv'in Python'undan yeniyse (ör. 3.9'la
# kurulmuş eski bir sunucu) pip yerinde kuramaz. Bu durumda sunucudaki en uygun yorumlayıcıyla (python3.12,
# python3.11, python3.10, python3) $APP/venv-py<sürüm>-<kimlik> altında YENİ bir venv kurulur, requirements oraya
# yüklenir ve $APP/venv bu dizine sembolik bağ olur (eski venv kenara alınır). Hata olursa geri dönüş eski venv'i
# de yerine koyar. Uygun yorumlayıcı yoksa hiçbir şeye dokunmadan çıkış kodu 3 ile durur (pops-selfupdate panelde
# "Python kurun" der).
#
# Bağımlılıklar: Backend/requirements.lock varsa (bütün bağımlılıklar, SHA-256 özetleriyle; tools/backend_lock.sh)
# pip "--require-hashes -r requirements.lock" ile kurar: PyPI'den gelen dosyanın özeti tutmazsa pip hiçbir şey
# kurmadan durur ve deploy geri döner. Kilidi olmayan eski bir checkout'ta requirements.txt kullanılır. "Requirements
# değişti" kararı ikisini de karşılaştırır.
#
# Veritabanı: başında "-- pops: dump-before" satırı olan bir migration (tabloları yeniden yazan, eski kodun çalışamayacağı
# değişiklik; ör. 0031 TEXT -> TIMESTAMPTZ) henüz uygulanmamışsa, servis yeniden başlamadan ÖNCE pg_dump -Fc ile
# $APP/.deploy-backups/db-<zaman>.dump alınır (.env'deki DB_* ile; en çok 3 ve KEEP_BACKUPS kadar saklanır). Yer
# yetmezse ya da dump alınamazsa hiçbir şeye dokunulmadan durulur. Bu deploy geri dönerse kod eski hâline döner ama
# uygulanmış migration geri alınmaz: betik dump'ı eski kodla geri yükleme komutunu yazar (docs/deployment.md).
#
# Ayarlar: /etc/pops/deploy.conf (REPO, APP, SVC, OWNER, HEALTH_BASE, HEALTH_WAIT, KEEP_BACKUPS; örnek ve açıklama:
# Installer/server/deploy.conf.example). Dosya yoksa install.sh'in varsayılanları geçerlidir. pops-selfupdate
# da REPO'yu aynı dosyadan okur.
#
# NOT: Bu, sürüm takibi için tutulan REFERANS kopyadır. Canlıda çalışan authoritative
# kopya hâlâ /usr/local/sbin/pops-deploy-backend'dedir (root'a ait, betiğin kendini çalışma
# sırasında ezmemesi için repoda değil host'ta durur). Bu dosyayı değiştirdiğinizde
# host'takini de elle güncelleyin:  sudo install -m 755 Installer/server/pops-deploy-backend /usr/local/sbin/
#
# Test kancaları (Installer/server/tests/test_deploy.sh): POPS_DEPLOY_CONF ayar dosyasının yolu,
# POPS_DEPLOY_ALLOW_NONROOT=1 root olmadan çalışma, POPS_DEPLOY_PYTHONS yeni venv için aranan yorumlayıcılar,
# POPS_DEPLOY_FREE_KB yedek dizinindeki boş yer (KB; df yerine).
# Üretimde hiçbiri verilmez.
set -Eeuo pipefail

CONF=${POPS_DEPLOY_CONF:-/etc/pops/deploy.conf}
# Varsayılanlar = install.sh'inkiler. REPO: betik bir POps checkout'unun içinden çalışıyorsa o checkout
# (install.sh de kurduğu checkout'u deploy.conf'a yazar); /usr/local/sbin'deki kopya için deploy.conf gerekir.
REPO=""
_self=$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd || true)
if [ -n "$_self" ] && [ -f "$_self/Backend/server.py" ]; then REPO=$_self; fi
APP=/opt/pops
SVC=pops
OWNER=pops
HEALTH_BASE=http://127.0.0.1:8000
KEEP_BACKUPS=10
HEALTH_WAIT=60
STAMP=$(date +%Y%m%d-%H%M%S)
# Venv'in Python'u eskiyse yeni venv için sırayla denenen yorumlayıcılar (ilk uyan seçilir)
PY_CANDIDATES=${POPS_DEPLOY_PYTHONS:-python3.12 python3.11 python3.10 python3}

die() { echo "pops-deploy-backend: $*" >&2; exit 1; }

# Ayar dosyası kabukla okunur (.): yalnızca root'un (ya da betiği çalıştıranın) yazabildiği, sembolik bağ
# olmayan bir dosyaya ve dizine güvenilir. Aksi hâlde onu değiştirebilen biri root olarak kod çalıştırırdı.
trusted_file() {   # $1=yol; 0: güvenilir
    local p
    for p in "$1" "$(dirname "$1")"; do
        if [ -L "$p" ]; then return 1; fi
        case "$(stat -c %u "$p")" in 0|"$(id -u)") ;; *) return 1 ;; esac
        if [ $(( 8#$(stat -c %a "$p") & 8#022 )) -ne 0 ]; then return 1; fi
    done
}

[ "$(id -u)" -eq 0 ] || [ "${POPS_DEPLOY_ALLOW_NONROOT:-0}" = 1 ] || die "root olarak çalıştır"
if [ -e "$CONF" ] || [ -L "$CONF" ]; then
    trusted_file "$CONF" || die "$CONF güvenli değil (root'a ait olmalı, grup/diğerleri yazamamalı, sembolik bağ olmamalı); okunmadı, hiçbir şey değiştirilmedi."
    # shellcheck disable=SC1090
    . "$CONF"
fi

# Bir şeye dokunmadan önce: yollar, kullanıcı ve servis gerçekten var mı?
if [ -z "$REPO" ] || [ ! -d "$REPO/Backend" ]; then
    die "REPO bulunamadı: '$REPO' (Backend/ içeren git checkout'u olmalı; ayar: $CONF). Hiçbir şey değiştirilmedi."
fi
if [ -z "$APP" ] || [ ! -d "$APP" ]; then die "APP bulunamadı: '$APP' (ayar: $CONF). Hiçbir şey değiştirilmedi."; fi
id -u "$OWNER" >/dev/null 2>&1 || die "OWNER kullanıcısı yok: '$OWNER' (ayar: $CONF). Hiçbir şey değiştirilmedi."
GROUP=$(id -gn "$OWNER")
# Baştaki sıfır da reddedilir: kabuk aritmetiği 010'u sekizlik okur, 00 ise bütün yedekleri sildirirdi
case "$KEEP_BACKUPS" in ''|*[!0-9]*|0*) die "KEEP_BACKUPS 1 ya da daha büyük bir sayı olmalı (ayar: $CONF)" ;; esac
case "$HEALTH_WAIT" in ''|*[!0-9]*|0[0-9]*) die "HEALTH_WAIT saniye olmalı (ayar: $CONF)" ;; esac
SVC=${SVC%.service}
[ "$(systemctl show -p LoadState --value "$SVC.service" 2>/dev/null)" = loaded ] \
    || die "systemd birimi bulunamadı: '$SVC' (ayar: $CONF). Hiçbir şey değiştirilmedi."
VENV="$APP/venv"
BACKUPS="$APP/.deploy-backups"
ID="$STAMP-$$"                                  # PID: aynı saniyedeki iki deploy birbirinin yedeğini ezmesin
BACKUP="$BACKUPS/code-$ID.tgz"
PRE_LIST="$BACKUPS/code-$ID.list"               # kurulum ÖNCESİ dosyalar: geri dönüşte yeni eklenenler silinir
VENV_BACKUP=""                                  # requirements değiştiyse ya da venv yeniden kuruluyorsa: $BACKUPS/venv-$ID.tgz
VENV_REAL=""
REBUILD=0                                       # 1: venv'in Python'u eski; yeni venv kurulup yerine konur
NEW_VENV=""                                     # yeni venv'in gerçek dizini ($APP/venv-py<sürüm>-$ID)
NEW_VENV_TEMP=0                                 # 1: yeni venv henüz canlı değil; hata olursa silinir
VENV_ASIDE="$APP/.venv.old-$ID"                 # yeniden kurulumda eski venv (dizin ya da bağ) burada bekler
CHANGED=0                                       # 1: canlıda bir şey değişti; bundan sonraki her hata geri döner
DB_DUMP=""                                      # migration öncesi veritabanı yedeği (alındıysa): $BACKUPS/db-$ID.dump
DUMP_MARK="-- pops: dump-before"                # bu satırı taşıyan migration'dan önce veritabanı yedeklenir

# Deploy'un canlıda tek tek yönettiği dosyalar (pops/ paketi ayrıca bütün olarak silinip açılır)
managed_files() {
    local f
    ( cd "$APP" && for f in ./*.py ./migrations/*.sql ./keys/* ./requirements.txt ./requirements.lock ./VERSION; do
        if [ -e "$f" ]; then printf '%s\n' "$f"; fi
    done )
}

rollback() {   # $1=neden. Kod setini ve (değiştiyse) venv'i yedekten geri yükler, servisi yeniden başlatır, çıkar.
    set +e   # geri yüklemenin hiçbir adımı yarıda kesilmesin
    trap - ERR
    trap '' INT TERM HUP PIPE   # çıktıyı okuyan (ör. ssh | tee) ölse de geri yükleme yarıda kalmasın
    echo "$1, önceki kod seti geri yükleniyor ($BACKUP)."
    # Bu deploy'un YENİ eklediği dosyaları sil (öncesinde yoklardı)
    managed_files | grep -vxF -f "$PRE_LIST" | ( cd "$APP" && xargs -r rm -f )
    rm -rf "$APP/pops"
    # root olarak açılan arşiv dosyaların sahibini ve iznini de geri getirir; ayrıca chown yapılmaz (APP'te root'a
    # ait yönetim betikleri olabilir, servis kullanıcısına geçmemeli)
    tar xzf "$BACKUP" -C "$APP" || echo "UYARI: kod yedeği açılamadı: $BACKUP"
    if [ "$REBUILD" = 1 ]; then
        # Eski venv'e hiç dokunulmadı, yalnızca kenara alındı: geri konur, yeni venv silinir
        if [ -e "$VENV_ASIDE" ] || [ -L "$VENV_ASIDE" ]; then
            echo "eski venv geri konuyor ($VENV_ASIDE -> $VENV)."
            if [ -L "$VENV" ]; then rm -f "$VENV"; fi
            mv -T "$VENV_ASIDE" "$VENV" || echo "UYARI: eski venv geri konamadı; elle:  rm $VENV; mv $VENV_ASIDE $VENV"
        fi
        if [ "$NEW_VENV_TEMP" = 1 ]; then rm -rf "$NEW_VENV"; fi
    elif [ -n "$VENV_BACKUP" ]; then
        # pip'in yarım bıraktığı venv kenara alınır, anlık görüntü AYNI mutlak yola açılır
        # (konsol betiklerinin #! satırları venv'in yolunu içerir).
        echo "venv de geri yükleniyor ($VENV_BACKUP)."
        local parent name failed
        parent=$(dirname "$VENV_REAL"); name=$(basename "$VENV_REAL")
        failed="$parent/.$name.failed-$ID"
        if mv "$VENV_REAL" "$failed" && tar xzf "$VENV_BACKUP" -C "$parent"; then
            rm -rf "$failed"
        else
            echo "UYARI: venv geri yüklenemedi; elle:  tar xzf $VENV_BACKUP -C $parent"
            if [ -d "$failed" ]; then rm -rf "$VENV_REAL"; mv "$failed" "$VENV_REAL"; fi
        fi
    fi
    systemctl restart "$SVC"
    if [ -n "$DB_DUMP" ]; then
        echo "DİKKAT: bu deploy veritabanını dönüştüren bir migration içeriyordu ve servis yeni kodla başlamıştı;"
        echo "migration uygulanmışsa eski kod veritabanıyla çalışmaz. Deploy'dan hemen önce alınan yedeği eski kodla"
        echo "geri yükleyin (arada yazılan kayıtlar kaybolur; bkz. docs/deployment.md):"
        echo "  systemctl stop $SVC"
        echo "  sudo -u postgres pg_restore --clean --if-exists --no-owner --role=<DB_USER> -d <DB_NAME> $DB_DUMP"
        echo "  systemctl start $SVC"
    fi
    exit 1
}

drop_new_venv() {   # canlıya alınmamış yeni venv'i siler (değişiklik öncesi hata/sinyal)
    if [ "$NEW_VENV_TEMP" = 1 ]; then rm -rf "$NEW_VENV"; fi
}
on_error() {   # set -e'nin yakaladığı her hata buradan geçer
    [ "$BASHPID" = "$$" ] || return 0   # alt kabuk / komut ikamesi: hatayı ana kabuk ayrıca görür
    if [ "$CHANGED" = 1 ]; then rollback "Hata (satır $1)"; fi
    drop_new_venv
    echo "pops-deploy-backend: hata (satır $1); canlıda hiçbir şey değiştirilmedi." >&2
    exit 1
}
on_signal() {
    if [ "$CHANGED" = 1 ]; then rollback "Deploy kesildi"; fi
    drop_new_venv
    exit 1
}

# --- Python sürümü ---------------------------------------------------------------------------------------
ver_num() { echo $(( 10#${1%%.*} * 1000 + 10#${1#*.} )); }   # "3.10" -> 3010 (yalnızca X.Y biçimi)
ver_ok() {   # $1=sürüm (X.Y); MIN_PY ya da daha yeniyse 0
    [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]] && [ "$(ver_num "$1")" -ge "$(ver_num "$MIN_PY")" ]
}
# Yorumlayıcının X.Y sürümü; çalışmazsa boş. -I -S: ortam, site-packages ve .pth dosyaları okunmaz.
py_ver() { "$@" -I -S -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true; }
find_python() {   # MIN_PY'yi karşılayan ilk aday: NEW_PY ve NEW_PY_VER'i doldurur
    local c p v
    for c in $PY_CANDIDATES; do
        p=$(command -v "$c" 2>/dev/null) || continue
        v=$(py_ver "$p")
        if ver_ok "$v"; then NEW_PY=$p; NEW_PY_VER=$v; return 0; fi
    done
    return 1
}
build_venv() {   # NEW_VENV'e OWNER olarak venv + requirements; herhangi bir adım başarısızsa 1
    install -d -o "$OWNER" -g "$GROUP" -m 755 "$NEW_VENV" || return 1
    sudo -H -u "$OWNER" "$NEW_PY" -m venv --upgrade-deps "$NEW_VENV" || return 1
    # Servis kullanıcısı repo klasörünü okuyamaz: kilit (ya da requirements) yeni venv'in içine kopyalanıp oradan kurulur
    install -o "$OWNER" -g "$GROUP" -m 644 "Backend/$REQ_FILE" "$NEW_VENV/pops-$REQ_FILE" || return 1
    sudo -H -u "$OWNER" "$NEW_VENV/bin/pip" install -q --disable-pip-version-check \
        "${PIP_REQ[@]}" "$NEW_VENV/pops-$REQ_FILE" || return 1
    rm -f "$NEW_VENV/pops-$REQ_FILE"
}
trap 'on_error $LINENO' ERR
trap on_signal INT TERM HUP

cd "$REPO"
git rev-parse --git-dir >/dev/null || die "REPO'da git çalışmıyor: $REPO (git checkout'u değil ya da sahiplik/safe.directory; git hatası yukarıda)"

# Yalnız commit'lenmiş kod canlıya gider: değişiklik ya da izlenmeyen dosya varsa dur.
if ! git diff --quiet HEAD -- Backend || [ -n "$(git ls-files --others --exclude-standard Backend)" ]; then
    echo "Backend/ altında commit'lenmemiş ya da izlenmeyen dosya var, önce commit'le."
    exit 1
fi
REV=$(git rev-parse --short HEAD)

# pip'in kurduğu dosya: kilit varsa özetler zorunlu; yoksa (kilidi olmayan eski checkout) requirements.txt
if [ -f Backend/requirements.lock ]; then
    REQ_FILE=requirements.lock; PIP_REQ=(--require-hashes -r)
else
    REQ_FILE=requirements.txt; PIP_REQ=(-r)
fi

# Dağıtılan kod seti = git'te İZLENEN Backend altındaki .py'ler (server.py, migrate.py, pops/ paketi...;
# testler hariç). git pathspec'te '*' alt dizinleri de kapsar.
mapfile -t CODE < <(git ls-files 'Backend/*.py' | grep -v '^Backend/tests/' | sort)
[ "${#CODE[@]}" -gt 0 ] || { echo "Dağıtılacak kod bulunamadı"; exit 1; }

# Kaynak manifesti: "<canlıdaki göreli yol> <sha256>" (VERSION ve anahtar repo kökünden gelir)
manifest_src() {
    for f in "${CODE[@]}"; do printf '%s %s\n' "${f#Backend/}" "$(sha256sum < "$f" | cut -d' ' -f1)"; done
    for f in Backend/migrations/*.sql; do printf 'migrations/%s %s\n' "$(basename "$f")" "$(sha256sum < "$f" | cut -d' ' -f1)"; done
    printf 'requirements.txt %s\n' "$(sha256sum < Backend/requirements.txt | cut -d' ' -f1)"
    if [ -f Backend/requirements.lock ]; then
        printf 'requirements.lock %s\n' "$(sha256sum < Backend/requirements.lock | cut -d' ' -f1)"
    fi
    printf 'VERSION %s\n' "$(sha256sum < VERSION | cut -d' ' -f1)"
    printf 'keys/pops_release_ed25519.pub.pem %s\n' "$(sha256sum < keys/pops_release_ed25519.pub.pem | cut -d' ' -f1)"
}
same=1
while read -r rel sum; do
    [ -e "$APP/$rel" ] && [ "$(sha256sum < "$APP/$rel" | cut -d' ' -f1)" = "$sum" ] || { same=0; break; }
done < <(manifest_src)
# Kaynaktan silinmiş ama canlıda kalmış bir pops modülü de fark sayılır
if [ "$same" = 1 ] && [ -d "$APP/pops" ]; then
    extra=$(cd "$APP" && find pops -name '*.py' | sort | comm -23 - <(printf '%s\n' "${CODE[@]}" | sed 's#^Backend/##' | grep '^pops/' | sort))
    [ -z "$extra" ] || same=0
fi
if [ "$same" = 1 ]; then
    echo "Canlı backend zaten $REV ile aynı."
    exit 0
fi

# Venv'in Python'u bu sürümün istediğinden eskiyse (requirements.txt: "# requires-python: >=X.Y"; satır yoksa 3.10)
# yerinde pip install yapılamaz: yeni venv kurulacak. Uygun yorumlayıcı yoksa hiçbir şeye dokunmadan dur (çıkış 3).
MIN_PY=$(sed -n 's/^#[[:space:]]*requires-python:[[:space:]]*>=[[:space:]]*\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' \
    Backend/requirements.txt | head -1)
MIN_PY=${MIN_PY:-3.10}
if [ -d "$VENV" ]; then
    # Venv servis kullanıcısına aittir: yorumlayıcısı root olarak çalıştırılmaz
    VENV_VER=$(py_ver sudo -H -u "$OWNER" "$VENV/bin/python")
    if ! ver_ok "$VENV_VER"; then
        if ! find_python; then
            echo "pops-deploy-backend: venv'in Python'u (${VENV_VER:-çalışmıyor}) bu sürüm için eski; Python $MIN_PY ya da daha yenisi gerekli, sunucuda bulunamadı (aranan: $PY_CANDIDATES). Root olarak python3.12 kurun (AlmaLinux/RHEL/Rocky 9: dnf install python3.12; Ubuntu 22.04: apt install python3.12 python3.12-venv, deadsnakes PPA) ve güncellemeyi yeniden başlatın; deploy yeni bir venv kurar. Hiçbir şey değiştirilmedi." >&2
            exit 3
        fi
        REBUILD=1
        NEW_VENV="$APP/venv-py$NEW_PY_VER-$ID"
        echo "venv'in Python'u (${VENV_VER:-çalışmıyor}) eski (gereken: >=$MIN_PY): $NEW_PY ($NEW_PY_VER) ile yeni venv kuruluyor: $NEW_VENV"
        NEW_VENV_TEMP=1
        if ! build_venv; then
            drop_new_venv
            die "yeni venv kurulamadı ($NEW_PY; Debian/Ubuntu'da python$NEW_PY_VER-venv paketi gerekir; pip hatası yukarıda). Hiçbir şey değiştirilmedi."
        fi
    fi
fi

# Geri dönüş için mevcut canlı kod setinin TAMAMINI yedekle
install -d -o "$(id -u)" -g "$(id -g)" -m 700 "$BACKUPS"   # üretimde root:root
managed_files > "$PRE_LIST"
mapfile -t ITEMS < <(cd "$APP" && for f in ./*.py pops migrations keys requirements.txt requirements.lock VERSION; do
    if [ -e "$f" ]; then printf '%s\n' "$f"; fi
done)
tar czf "$BACKUP" -C "$APP" --exclude='__pycache__' -- "${ITEMS[@]}"

# requirements değiştiyse pip, çalışan venv'e kurar: önce venv'in TAMAMININ anlık görüntüsü (geri dönüşte
# aynı mutlak yola açılır). Görüntü alınamazsa (disk dolu vb.) hiçbir şeye dokunmadan dur. Venv yeniden
# kuruluyorsa eski venv'e dokunulmaz; görüntü yalnızca sonradan elle geri dönüş içindir (eski dizin silinir).
REQ_CHANGED=0
cmp -s Backend/requirements.txt "$APP/requirements.txt" || REQ_CHANGED=1
# Yalnızca kilit değiştiyse de (ör. dolaylı bir bağımlılığın sürümü ya da özeti) pip çalışır
if [ -f Backend/requirements.lock ] && ! cmp -s Backend/requirements.lock "$APP/requirements.lock"; then REQ_CHANGED=1; fi
if [ "$REBUILD" = 1 ]; then
    VENV_REAL=$(readlink -f "$VENV")
    VENV_BACKUP="$BACKUPS/venv-$ID.tgz"
    rc=0; tar czf "$VENV_BACKUP" -C "$(dirname "$VENV_REAL")" "$(basename "$VENV_REAL")" || rc=$?
    if [ "$rc" -gt 1 ]; then
        rm -f "$VENV_BACKUP" "$BACKUP" "$PRE_LIST"; drop_new_venv
        die "venv yedeklenemedi ($VENV_BACKUP; disk dolu mu?). Hiçbir şey değiştirilmedi."
    fi
elif [ "$REQ_CHANGED" = 1 ]; then
    [ -x "$VENV/bin/pip" ] || { rm -f "$BACKUP" "$PRE_LIST"; die "$VENV/bin/pip yok (venv bulunamadı). Hiçbir şey değiştirilmedi."; }
    VENV_REAL=$(readlink -f "$VENV")
    # pip OWNER olarak çalışır: venv'de başka bir kullanıcıya ait dosya (ör. bir zamanlar root'la kurulmuş paket)
    # varsa eski sürümü kaldıramaz ve yarıda kalır. Bir şeye dokunmadan önce dur, düzeltmeyi söyle.
    foreign=$(find "$VENV_REAL" ! -user "$OWNER" 2>/dev/null | wc -l)
    if [ "$foreign" -gt 0 ]; then
        example=$(find "$VENV_REAL" ! -user "$OWNER" -print -quit 2>/dev/null)
        rm -f "$BACKUP" "$PRE_LIST"
        die "venv'de $OWNER kullanıcısına ait olmayan $foreign dosya var (ör. $example); pip eski paketleri kaldıramaz. Düzeltmek için: chown -R $OWNER:$GROUP $VENV_REAL ve yeniden deneyin. Hiçbir şey değiştirilmedi."
    fi
    VENV_BACKUP="$BACKUPS/venv-$ID.tgz"
    # tar 1 = çalışan servis o sırada bir .pyc yazdı ("file changed as we read it"; Python bunu atomik yazar,
    # görüntü kullanılabilir). 2 ve üstü gerçek hata.
    rc=0; tar czf "$VENV_BACKUP" -C "$(dirname "$VENV_REAL")" "$(basename "$VENV_REAL")" || rc=$?
    if [ "$rc" -gt 1 ]; then
        rm -f "$VENV_BACKUP" "$BACKUP" "$PRE_LIST"
        die "venv yedeklenemedi ($VENV_BACKUP; disk dolu mu?). Hiçbir şey değiştirilmedi."
    fi
fi

# Saklama: en yeni KEEP_BACKUPS geri dönüş noktası; her kod yedeği aynı adlı venv görüntüsüyle birlikte silinir
# Adlar betiğin ürettiği code-<zaman>-<pid>.tgz biçiminde; ls -t yalnızca zamana göre sıralar.
# shellcheck disable=SC2012
ls -1t "$BACKUPS"/code-*.tgz | tail -n +$((KEEP_BACKUPS + 1)) | while read -r old; do
    rm -f "$old" "${old%.tgz}.list" "$BACKUPS/venv-${old##*/code-}"
done
for v in "$BACKUPS"/venv-*.tgz; do
    if [ -e "$v" ] && [ ! -e "$BACKUPS/code-${v##*/venv-}" ]; then rm -f "$v"; fi
done

# Migration öncesi veritabanı yedeği: bekleyen bir migration "$DUMP_MARK" taşıyorsa (bkz. baştaki açıklama)
envval() {   # $APP/.env'den tek değer (dosya ÇALIŞTIRILMAZ): KEY=değer, isteğe bağlı tırnak
    sed -n "s/^$1=//p" "$APP/.env" 2>/dev/null | tail -n1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}
heavy=()
for f in Backend/migrations/*.sql; do
    if [ ! -e "$APP/migrations/$(basename "$f")" ] && grep -qxF -- "$DUMP_MARK" "$f"; then heavy+=("$(basename "$f" .sql)"); fi
done
if [ "${#heavy[@]}" -gt 0 ]; then
    DB_HOST=$(envval DB_HOST); DB_PORT=$(envval DB_PORT); DB_USER=$(envval DB_USER); DB_NAME=$(envval DB_NAME)
    DB_HOST=${DB_HOST:-localhost}; DB_PORT=${DB_PORT:-5432}
    PGPASSWORD=$(envval DB_PASS); export PGPASSWORD
    abort_dump() { rm -f "$BACKUP" "$PRE_LIST" "${VENV_BACKUP:-}" "$BACKUPS/db-$ID.dump"; drop_new_venv; die "$1 Hiçbir şey değiştirilmedi."; }
    [ -n "$DB_USER" ] && [ -n "$DB_NAME" ] || abort_dump "migration öncesi yedek için $APP/.env'de DB_USER/DB_NAME yok."
    PSQL=(psql -X -A -t -q -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME")
    # Veritabanında zaten uygulanmışsa (ör. yarıda kalmış bir önceki deploy) yeniden yedek gerekmez
    applied=$("${PSQL[@]}" -c "SELECT version FROM schema_migrations" 2>/dev/null || true)
    todo=()
    for v in "${heavy[@]}"; do grep -qxF -- "$v" <<<"$applied" || todo+=("$v"); done
    if [ "${#todo[@]}" -gt 0 ]; then
        size_kb=$("${PSQL[@]}" -c "SELECT pg_database_size(current_database()) / 1024" 2>/dev/null) \
            || abort_dump "veritabanına bağlanılamadı (migration öncesi yedek: ${todo[*]})."
        free_kb=${POPS_DEPLOY_FREE_KB:-$(df -Pk "$BACKUPS" | awk 'NR == 2 {print $4}')}
        # Sıkıştırılmış dump veritabanından küçüktür; yine de veritabanı boyutu + 100 MB boş yer istenir
        if [ "$free_kb" -lt $(( size_kb + 102400 )) ]; then
            abort_dump "migration öncesi yedek için yer yok: $BACKUPS'ta ${free_kb} KB boş, veritabanı ${size_kb} KB."
        fi
        echo "Veritabanı dönüştüren migration (${todo[*]}): önce yedek alınıyor ($BACKUPS/db-$ID.dump)."
        pg_dump -Fc -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -f "$BACKUPS/db-$ID.dump" \
            || abort_dump "pg_dump başarısız (migration öncesi yedek)."
        chmod 600 "$BACKUPS/db-$ID.dump"
        DB_DUMP="$BACKUPS/db-$ID.dump"
        # Saklama: en çok 3 (KEEP_BACKUPS daha küçükse o kadar) veritabanı yedeği
        keep=$(( KEEP_BACKUPS < 3 ? KEEP_BACKUPS : 3 ))
        # shellcheck disable=SC2012
        ls -1t "$BACKUPS"/db-*.dump | tail -n +$((keep + 1)) | while read -r old; do rm -f "$old"; done
    fi
    unset PGPASSWORD
fi

CHANGED=1   # buradan sonra her hata (ERR, sinyal ya da açık denetim) rollback'ten geçer

# Servis kullanıcısı repo klasörünü okuyamaz; dosyalar $APP'e kopyalanır. Yeni venv'e requirements zaten kuruldu.
if [ "$REQ_CHANGED" = 1 ] || [ "$REBUILD" = 1 ]; then
    install -o "$OWNER" -g "$GROUP" -m 644 Backend/requirements.txt "$APP/requirements.txt"
    if [ "$REQ_FILE" = requirements.lock ]; then
        install -o "$OWNER" -g "$GROUP" -m 644 Backend/requirements.lock "$APP/requirements.lock"
    fi
fi
if [ "$REBUILD" = 0 ] && [ "$REQ_CHANGED" = 1 ]; then
    # --require-hashes: bir dosyanın özeti tutmazsa pip venv'e dokunmadan durur; deploy yine geri döner
    sudo -H -u "$OWNER" "$VENV/bin/pip" install -q --disable-pip-version-check "${PIP_REQ[@]}" "$APP/$REQ_FILE" \
        || rollback "pip install başarısız"
fi

# Migration SQL'leri (yalnız eklenir; server.py açılışta bekleyenleri idempotent uygular). Veritabanını dönüştüren
# migration'dan önce yedek yukarıda alındı ("$DUMP_MARK").
install -d -o "$OWNER" -g "$GROUP" -m 755 "$APP/migrations"
for f in Backend/migrations/*.sql; do
    install -o "$OWNER" -g "$GROUP" -m 644 "$f" "$APP/migrations/$(basename "$f")"
done

# pops/ paketi temiz kurulur (kaynaktan silinen modül canlıda kalmasın), sonra tüm kod dosyaları
rm -rf "$APP/pops"
for f in "${CODE[@]}"; do
    rel="${f#Backend/}"
    install -d -o "$OWNER" -g "$GROUP" -m 755 "$APP/$(dirname "$rel")"
    install -o "$OWNER" -g "$GROUP" -m 644 "$f" "$APP/$rel"
done

# Kök VERSION + release doğrulama açık anahtarı
install -o "$OWNER" -g "$GROUP" -m 644 VERSION "$APP/VERSION"
install -d -o "$OWNER" -g "$GROUP" -m 755 "$APP/keys"
install -o "$OWNER" -g "$GROUP" -m 644 keys/pops_release_ed25519.pub.pem "$APP/keys/pops_release_ed25519.pub.pem"

# Yeni venv yerine konur: eski venv (dizin ya da önceki yeniden kurulumun bağı) kenara, $APP/venv yeni dizine bağ.
# Konsol betiklerinin #! satırları yeni dizinin gerçek yolunu içerir; systemd'nin $APP/venv/bin/uvicorn'u değişmez.
if [ "$REBUILD" = 1 ]; then
    mv -T "$VENV" "$VENV_ASIDE"
    ln -s "$(basename "$NEW_VENV")" "$VENV"
fi

systemctl restart "$SVC" || rollback "Servis yeniden başlatılamadı"

# Açılış (bekleyen migration'lar, indeks kurulumu dahil) birkaç saniyeden uzun sürebilir: sağlık HEALTH_WAIT
# saniyeye kadar 2 sn arayla beklenir; servis ayakta ve /api/health 200 olunca diğer uçlar denetlenir.
ok=0
for _ in $(seq 1 $(( HEALTH_WAIT > 2 ? HEALTH_WAIT / 2 : 1 ))); do
    sleep 2
    if systemctl is-active --quiet "$SVC" \
        && [ "$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$HEALTH_BASE/api/health")" = 200 ]; then
        ok=1
        break
    fi
done
if [ "$ok" = 1 ]; then
    [ "$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$HEALTH_BASE/api/agent_policies")" = 200 ] || ok=0
    [ "$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$HEALTH_BASE/api/devices")" = 401 ] || ok=0
fi

if [ "$ok" = 1 ]; then
    CHANGED=0
    if [ "$REBUILD" = 1 ]; then
        NEW_VENV_TEMP=0
        # Eski venv artık yalnızca görüntüde: kenara alınan dizin (ya da bağ ve onun gösterdiği, bu betiğin
        # önceden kurduğu venv-py* dizini) silinir. Silinemezse deploy yine başarılıdır.
        rm -rf "$VENV_ASIDE" || echo "UYARI: eski venv silinemedi: $VENV_ASIDE"
        case "$VENV_REAL" in
            "$(readlink -f "$APP")"/venv-py*) rm -rf "$VENV_REAL" || echo "UYARI: eski venv silinemedi: $VENV_REAL" ;;
        esac
        echo "venv Python $NEW_PY_VER ile yeniden kuruldu: $VENV -> $NEW_VENV"
    fi
    echo "Backend $REV canlıda. Yedek: $BACKUP${VENV_BACKUP:+ (venv: $VENV_BACKUP)}${DB_DUMP:+ (veritabanı: $DB_DUMP)}"
else
    journalctl -u "$SVC" -n 20 --no-pager || true
    rollback "Sağlık kontrolü başarısız"
fi
