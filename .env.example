# =====================================================================
# POps ortam değişkenleri
# =====================================================================
# Otomatik kurulum (önerilen): bağımlılıkları kurar, bu şablondan .env üretir,
# gizli değerleri rastgele doldurur ve DB / panel yönetici şifrelerini yeniler:
#     python3 Backend/setup_env.py
# Elle kurulum için bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun:
#     cp .env.example .env
# ".env" git'e eklenmez (.gitignore). Şifre, anahtar ve IP gibi ortama özel
# değerler koda gömülmez; buradan veya sistem ortam değişkenlerinden okunur.
#
# - Backend (server.py) bu dosyayı python-dotenv ile okur
#   (Backend/.env veya proje kökündeki .env).
# - Dashboard (PHP) önce web sunucusunun ortam değişkenlerine, sonra
#   proje kökündeki .env dosyasına bakar.
# =====================================================================

# ─── Backend: Kimlik doğrulama ────────────────────────────────────────
# JWT anahtarı (zorunlu). Üretmek için:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Token ömrü (saat)
JWT_EXPIRE_HOURS=12
# Çevrimdışı bypass kodu için ajanlarla paylaşılan gizli anahtar. Ajanlardaki
# BypassSecret (appsettings.json) / POPS_BYPASS_SECRET ile aynı olmalıdır.
# Boşsa panel bypass kodu üretmez. Kod günlük değişir; sunucu ve ajanlar aynı
# saat diliminde olmalıdır.
BYPASS_SECRET=

# ─── Backend: Veritabanı (PostgreSQL) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
# Zorunlu
DB_USER=
DB_PASS=
DB_NAME=

# Bağlantı havuzu (en az / en çok). PostgreSQL başka uygulamalarla paylaşılıyorsa DB_POOL_MAX'ı
# sunucunun max_connections değerinin altında tutun; yük artarsa ikisini birlikte büyütün.
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── Backend: İlk panel yöneticisi ────────────────────────────────────
# Bu kullanıcı veritabanında yoksa ilk açılışta superadmin olarak oluşturulur.
# Hesap oluştuktan sonra şifre panelden değiştirilebilir; bu değer tekrar yazılmaz.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=

# ─── Backend: Ağ ──────────────────────────────────────────────────────
# Virgülle ayrılmış CORS origin listesi (örn. https://pops.example.com).
# Panel, API ile aynı origin'den sunuluyorsa boş bırakılabilir.
CORS_ALLOWED_ORIGINS=
# Wake-on-LAN yayın adresi ve portu. Boş bırakılırsa 255.255.255.255 kullanılır;
# yönlendirilmiş alt ağlar için alt ağın yayın adresini yazın (örn. 10.0.5.255).
WOL_BROADCAST_ADDR=
WOL_PORT=9

# ─── Backend: Bildirimler (e-posta, isteğe bağlı) ─────────────────────
# Önemli olaylar panel zilinde her zaman görünür. E-posta ile de gönderilmesi için
# SMTP ayarlayın; alıcılar ve webhook adresi panelden (Sistem & Sürüm > Bildirimler)
# girilir. Boş bırakılırsa e-posta gönderilmez (webhook yine çalışır).
SMTP_HOST=
# 587 (starttls) | 465 (ssl) | 25 (none, yalnızca yerel/güvenilir relay)
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
# Gönderen adresi (boşsa SMTP_USER)
SMTP_FROM=
# Webhook yalnızca internetteki adreslere gider; okul içindeki bir sisteme (ör. 10.x) göndermek için 1
NOTIFY_WEBHOOK_ALLOW_PRIVATE=

# ─── Log ve metrikler ─────────────────────────────────────────────────
# json (journald/log toplayıcı için) ya da text (geliştirme)
LOG_FORMAT=json
LOG_LEVEL=INFO
# Prometheus /metrics yalnızca bu jeton tanımlıysa açılır (en az 16 karakter, Authorization: Bearer <jeton>)
METRICS_TOKEN=

# ─── Dashboard (PHP) ──────────────────────────────────────────────────
# Panelin sunucu tarafında (PHP -> FastAPI) giriş isteği gönderdiği iç API adresi
POPS_API_INTERNAL_URL=http://127.0.0.1:8000

# ─── Agent (Windows) ──────────────────────────────────────────────────
# Ajan bu dosyayı okumaz. Ajan ayarları C:\POps\appsettings.json içinde
# ("ServerUrl", "BypassSecret") veya POPS_SERVER_URL / POPS_BYPASS_SECRET
# sistem ortam değişkenleriyle verilir.
