# =====================================================================
# POps ortam değişkenleri
# =====================================================================
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun:
#     cp .env.example .env
# ".env" git'e eklenmez (.gitignore). Şifre, anahtar ve IP gibi ortama özel
# değerler koda gömülmez; buradan veya sistem ortam değişkenlerinden okunur.
#
# - Backend (server.py) bu dosyayı python-dotenv ile okur
#   (Backend/.env veya proje kökündeki .env).
# - Dashboard (PHP) önce web sunucusunun ortam değişkenlerine, sonra
#   proje kökündeki .env dosyasına bakar.
# =====================================================================

# ─── Backend: Kimlik doğrulama ────────────────────────────────────────
# JWT anahtarı (zorunlu). Üretmek için:
#     python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Token ömrü (saat)
JWT_EXPIRE_HOURS=12

# ─── Backend: Veritabanı (PostgreSQL) ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
# Zorunlu
DB_USER=
DB_PASS=
DB_NAME=

# ─── Backend: İlk panel yöneticisi ────────────────────────────────────
# Bu kullanıcı veritabanında yoksa ilk açılışta superadmin olarak oluşturulur.
# Hesap oluştuktan sonra şifre panelden değiştirilebilir; bu değer tekrar yazılmaz.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=

# ─── Backend: Ağ ──────────────────────────────────────────────────────
# Virgülle ayrılmış CORS origin listesi (örn. https://pops.example.com).
# Panel, API ile aynı origin'den sunuluyorsa boş bırakılabilir.
CORS_ALLOWED_ORIGINS=
# Wake-on-LAN yayın adresi ve portu. Boş bırakılırsa 255.255.255.255 kullanılır;
# yönlendirilmiş alt ağlar için alt ağın yayın adresini yazın (örn. 10.0.5.255).
WOL_BROADCAST_ADDR=
WOL_PORT=9

# ─── Dashboard (PHP) ──────────────────────────────────────────────────
# Panelin sunucu tarafında (PHP -> FastAPI) giriş isteği gönderdiği iç API adresi
POPS_API_INTERNAL_URL=http://127.0.0.1:8000
# Log & Envanter sayfasındaki "tüm cihazları uyandır" işlemi için onay şifresi.
# Boş bırakılırsa şifre yerine yalnızca onay penceresi çıkar. Bu, yanlışlıkla toplu
# uyandırmayı önleyen bir onay adımıdır; asıl yetki kontrolü API'deki admin JWT'sidir.
POPS_WOL_CONFIRM_PASSWORD=

# ─── Agent (Windows) ──────────────────────────────────────────────────
# Ajan bu dosyayı okumaz. Ajan ayarları C:\POps\appsettings.json içinde
# ("ServerUrl", "BypassSecret") veya POPS_SERVER_URL / POPS_BYPASS_SECRET
# sistem ortam değişkenleriyle verilir.
