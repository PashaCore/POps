<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>POpsWatchdog</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Kullanıcı oturumunda çalışır: DOTNET_STARTUP_HOOKS ile kullanıcı kodu yüklenmesin (tepsiyle aynı) -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <!-- Ortak yardımcılar (sürüm, log, ayarlar, kimlik): Agent/POps.Shared -->
  <ItemGroup>
    <ProjectReference Include="..\..\POps.Shared\POps.Shared.csproj" />
    <Using Include="POps.Shared" />
  </ItemGroup>

  <!-- Yalnızca Windows'ta çalışır (servis denetimi, ACL): platform çözümleyicisine (CA1416) bildirilir -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
