<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
  </ItemGroup>

  <!-- Ortak yardımcılar (sürüm, log, ayarlar, kimlik): Agent/POps.Shared -->
  <ItemGroup>
    <ProjectReference Include="..\..\POps.Shared\POps.Shared.csproj" />
    <Using Include="POps.Shared" />
  </ItemGroup>

  <!-- Yalnızca Windows'ta çalışır (DirectX, GDI+, ACL): platform çözümleyicisine (CA1416) bildirilir -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
