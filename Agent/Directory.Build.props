<Project>

  <!--
    Tek sürüm kaynağı: repo kökündeki VERSION dosyası.
    Dört ajan projesi de (POps.Agent, POpsTray, POpsWatchdog, POpsUpdater)
    Agent/ altında olduğu için MSBuild proje dizininden yukarı yürürken bu dosyayı bulur
    ve <Version> hepsine buradan gelir. Sürümü değiştirmek için yalnızca kök VERSION
    dosyasını düzenleyin; koda gömülü sürüm sabiti bırakmayın.
  -->
  <PropertyGroup>
    <_PopsVersionFile>$(MSBuildThisFileDirectory)../VERSION</_PopsVersionFile>
    <_PopsVersionRaw>$([System.IO.File]::ReadAllText('$(_PopsVersionFile)'))</_PopsVersionRaw>
    <Version>$(_PopsVersionRaw.Trim())</Version>
    <!-- InformationalVersion'a "+<commit>" eklenmesin ki sürüm okuması deterministik kalsın. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Self-contained pakete yalnızca Türkçe uydu kaynakları girer (WinForms vb. 13 dil ~8 MB idi); diğer dillerde
         sistem iletileri İngilizce (nötr) görünür. Kod kırpma (trim) değildir. -->
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Uyarı kapısı: ürün projeleri (POps.Tests dışında) .NET 10 "recommended" çözümleyicileriyle derlenir ve her uyarı
    hata sayılır. Bugün var olan uyarılar Agent/.editorconfig'te dosya ve kural bazında tabana alınmıştır; taban
    dışındaki her yeni uyarı derlemeyi ve CI'ı durdurur. AnalysisLevel sabittir (latest değil): bir SDK güncellemesi
    yeni kurallarla derlemeyi kendiliğinden bozmasın; yükseltmek ayrı bir iştir. NuGet güvenlik uyarıları (NU1901-NU1904)
    hata sayılmaz: yeni yayımlanan bir açık ilgisiz değişiklikleri durdurmasın (Dependabot ayrıca bildirir).

    Nullable: her ürün projesinin csproj'unda <Nullable>enable</Nullable> var (Agent/ dışındaki MSI custom action
    projesi Installer/agent/CustomActions dahil; orada nullable uyarıları ayrıca hata sayılır). Nullable uyarıları da bu
    kapıya girer. Temiz olmayan eski dosyalarda "#nullable disable" satırı vardır (yeniler ilk satırda, eskiler
    using'lerin altında); bu da .editorconfig gibi bir tabandır ve yalnızca küçülür: dosya temizlenince satırı ve
    tools/nullable_baseline.txt'deki yolunu silin, yeni dosyaya bu satırı koymayın, yeni dosya nullable açısından temiz
    olmalı. CI'ın version işi (tools/check_nullable_baseline.py) listede olmayan bir dosyadaki bu satırı, listede olup
    silinmiş ya da artık bu satırı taşımayan dosyayı ve <Nullable>enable</Nullable>'ı olmayan ürün projesini hata sayar;
    proje başına sayıları da yazar. Tabandaki dosyalar (2026-10-05, Worker.cs bölmesinin a0 adımından sonra):
    POps.Agent 41, POps.Shared 9 (KioskPolicies.cs custom action'larda da derlenir), POpsUpdater 2, custom action'lar 1,
    POpsTray 0, POpsWatchdog 0.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'POps.Tests'">
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
