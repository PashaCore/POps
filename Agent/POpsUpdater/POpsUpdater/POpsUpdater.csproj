<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ajan updater'ı C:\POpsData\updater'a kopyalayıp oradan başlatır; kopyalanacak dosyaları
       POpsUpdater.deps.json'dan okur (AgentUpdate.UpdaterFiles). -->
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <!-- Ortak yardımcılar: POps.Shared.dll deps.json'a girer, ajan updater'ı onunla birlikte kopyalar -->
  <ItemGroup>
    <ProjectReference Include="..\..\POps.Shared\POps.Shared.csproj" />
    <Using Include="POps.Shared" />
  </ItemGroup>

</Project>
